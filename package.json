{
  "name": "nightfall-host",
  "version": "1.1.0",
  "license": "GPL-3.0-only",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.26",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-keep-awake": "~58.0.4",
    "expo-screen-capture": "~58.0.6",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "babel-preset-expo": "^58.0.25",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "react-dom": "19.3.0",
    "react-native-web": "^0.21.4",
    "react-test-renderer": "^19.3.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "desktop:install": "npm --prefix desktop ci",
    "desktop:prepare": "expo export --platform web --output-dir desktop/app",
    "desktop:check": "node --check desktop/main.cjs && node --check desktop/preload.cjs",
    "desktop:start": "npm run desktop:prepare && npm --prefix desktop start",
    "desktop:build:win": "npm run desktop:prepare && npm --prefix desktop run build:win",
    "desktop:build:mac:x64": "npm run desktop:prepare && npm --prefix desktop run build:mac -- --x64",
    "desktop:build:mac:arm64": "npm run desktop:prepare && npm --prefix desktop run build:mac -- --arm64",
    "desktop:preview": "node scripts/serve-desktop.cjs",
    "desktop:smoke": "node scripts/smoke-desktop.cjs",
    "assets:generate": "node scripts/generate-icons.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:engine": "tsx scripts/smoke-engine.ts",
    "test:regressions": "tsx scripts/regression-bugs.ts",
    "test:ui": "jest --runInBand"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/scripts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/build-output/"
    ],
    "testMatch": [
      "**/scripts/*.test.ts",
      "**/scripts/*.test.tsx"
    ]
  },
  "private": true
}
