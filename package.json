{
  "name": "nightfall-host",
  "version": "1.0.5",
  "license": "GPL-3.0-only",
  "main": "index.ts",
  "dependencies": {
    "expo": "~58.0.25",
    "expo-crypto": "~58.0.8",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-keep-awake": "~58.0.4",
    "expo-screen-capture": "~58.0.6",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "babel-preset-expo": "^58.0.25",
    "eslint": "^8.57.1",
    "eslint-config-expo": "^58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "react-dom": "19.3.0",
    "react-native-web": "^0.21.4",
    "react-test-renderer": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:engine": "tsx scripts/smoke-engine.ts",
    "test:regressions": "tsx scripts/regression-bugs.ts",
    "test:ui": "jest --runInBand"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/scripts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/build-output/"
    ],
    "testMatch": [
      "**/scripts/*.test.ts",
      "**/scripts/*.test.tsx"
    ]
  },
  "private": true
}
