{
  "name": "nightfall-host-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "夜幕主持助手的 Windows 与 macOS 桌面端",
  "author": "Nightfall Host contributors",
  "license": "GPL-3.0-only",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis portable --x64 --config electron-builder.yml",
    "build:mac": "electron-builder --mac dmg --config electron-builder.yml"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  }
}
